@page
@model ExpenseManagement.Pages.ApprovalsModel
@{
    ViewData["Title"] = "Approvals";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="error-banner">
        <h6>⚠️ Database Connection Issue</h6>
        <p class="mb-0">@Model.ErrorMessage</p>
        <small class="text-muted">Displaying sample data. Please check your database connection.</small>
    </div>
}

<div class="card">
    <div class="card-body">
        <h4 class="mb-4 fw-semibold">Pending Approvals</h4>
        
        <p class="text-muted mb-4">Review and approve submitted expenses.</p>
        
        <!-- Filter -->
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input type="text" class="form-control" name="filter" value="@Model.Filter" placeholder="Filter by name or description...">
            </div>
            <div class="col-md-2">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="btn btn-outline-primary d-block w-100">Filter</button>
            </div>
        </form>
        
        @if (Model.PendingExpenses.Any())
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Employee</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in Model.PendingExpenses)
                        {
                            <tr>
                                <td>@expense.ExpenseDate.ToString("dd MMM yyyy")</td>
                                <td>@expense.UserName</td>
                                <td>@expense.CategoryName</td>
                                <td>£@expense.AmountGBP.ToString("N2")</td>
                                <td>@expense.Description</td>
                                <td>
                                    <form method="post" style="display: inline;">
                                        <input type="hidden" name="expenseId" value="@expense.ExpenseId" />
                                        <input type="hidden" name="reviewerId" value="2" /> <!-- Default to Bob Manager -->
                                        <button type="submit" asp-page-handler="Approve" class="btn btn-sm btn-success">Approve</button>
                                        <button type="submit" asp-page-handler="Reject" class="btn btn-sm btn-danger">Reject</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" viewBox="0 0 16 16" class="mb-3">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 4a.905.905 0 0 0-.9.995l.35 3.507a.552.552 0 0 0 1.1 0l.35-3.507A.905.905 0 0 0 8 4zm.002 6a1 1 0 1 0 0 2 1 1 0 0 0 0-2z"/>
                </svg>
                <p class="mb-0">No pending expenses to approve.</p>
            </div>
        }
    </div>
</div>
